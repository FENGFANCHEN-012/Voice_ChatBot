# =====================================================================
# ENTERPRISE VOICE RAG CHATBOT — BACKEND ENVIRONMENT CONFIGURATION
# =====================================================================

# ---------------------------------------------------------------------
# LLM ENGINE SELECTION
# Options: "deepseek" (default), "gemini", or "auto"
# ---------------------------------------------------------------------
LLM_PROVIDER=deepseek

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

# Google Gemini API Configuration (Fallback / Alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# RETRIEVAL & VECTOR STORE
# Options: "chroma" (default) or "faiss"
# ---------------------------------------------------------------------
VECTOR_STORE_TYPE=chroma
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ---------------------------------------------------------------------
# WHISPER ASR & TTS VOICE
# ---------------------------------------------------------------------
WHISPER_MODEL_SIZE=base
WHISPER_USE_GPU=true
TTS_VOICE=en-US-AndrewMultilingualNeural

# ---------------------------------------------------------------------
# TESTING ENDPOINT OVERRIDE (Optional for backend/tests)
# Leave commented out to auto-detect from frontend/.env
# ---------------------------------------------------------------------
# Cloud GPU Target:
# API_BASE_URL=https://hash-phoniness-freely.ngrok-free.dev/api/v1
# Local Target:
# API_BASE_URL=http://localhost:8000/api/v1
